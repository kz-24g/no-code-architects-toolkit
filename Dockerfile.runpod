# === RunPod GPU 環境 ===
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# 環境變數
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# 1. 安裝基礎工具和 Python
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3-dev \
    build-essential \
    libmagic1 \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# 2. [關鍵修正] 手動加入 Jellyfin Repo 並安裝支援 NVENC 的 FFmpeg
# 這樣我們就不需要從 Docker Hub 拉取 jellyfin/ffmpeg image 了
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg && \
    export VERSION_CODENAME=$(lsb_release -c -s) && \
    echo "deb [signed-by=/etc/apt/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu $VERSION_CODENAME main" | tee /etc/apt/sources.list.d/jellyfin.list && \
    apt-get update && \
    apt-get install -y jellyfin-ffmpeg6 && \
    # 建立連結，讓系統找得到 ffmpeg
    ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg && \
    ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe && \
    rm -rf /var/lib/apt/lists/*

# 3. 解除 Ubuntu 的 pip 限制
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# 4. 設置 Python
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# 5. 安裝依賴
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir runpod requests

# 6. 複製代碼
COPY . .

# 創建臨時目錄
RUN mkdir -p /tmp/uploads && chmod 777 /tmp/uploads

EXPOSE 8080

# 啟動
CMD ["python", "-u", "runpod_handler.py"]