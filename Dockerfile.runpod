# === RunPod GPU 環境 (輕量化版) ===
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# 環境變數
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# 1. 安裝基礎工具、Python 和 [關鍵] 字體管理工具
# [優化] 移除了 Playwright 所需的 UI 依賴庫 (libgtk, libnss3 等)
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3-dev \
    build-essential \
    libmagic1 \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    # 字體管理工具 (解決中文亂碼必備)
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

# 2. 手動加入 Jellyfin Repo 並安裝支援 NVENC 的 FFmpeg
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg && \
    export VERSION_CODENAME=$(lsb_release -c -s) && \
    echo "deb [signed-by=/etc/apt/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu $VERSION_CODENAME main" | tee /etc/apt/sources.list.d/jellyfin.list && \
    apt-get update && \
    apt-get install -y jellyfin-ffmpeg6 && \
    ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg && \
    ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe && \
    rm -rf /var/lib/apt/lists/*

# 3. 解除 Ubuntu 的 pip 限制
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# 4. 設置 Python
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# 5. 安裝 Python 依賴
COPY requirements.txt .
# [優化] 移除了 openai-whisper 和 playwright
# 強制安裝核心套件以防快取問題
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir runpod requests jsonschema boto3 psutil ffmpeg-python

# 6. [關鍵] 複製本地字體到系統目錄
# 確保你的 Repo 根目錄下有 fonts 資料夾
COPY ./fonts /usr/share/fonts/custom_nca

# 7. [關鍵] 刷新字體快取
RUN fc-cache -f -v

# 8. 複製其餘代碼
COPY . .

# 創建臨時目錄
RUN mkdir -p /tmp/uploads && chmod 777 /tmp/uploads

EXPOSE 8080

# 啟動
CMD ["python", "-u", "runpod_handler.py"]